# Configuración del Backend - Onkos Instituto del Cáncer
# Copia este archivo como config.env y edita con tus valores

# API Key de Groq AI (obtener en https://console.groq.com/)
GROQ_API_KEY=[REDACTED]

# Puerto del servidor backend
PORT=3001

# Entorno de ejecución
NODE_ENV=development

# URL de conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/onkosdb

# Configuración adicional (opcional)
# CORS_ORIGIN=http://localhost:8080
# JWT_SECRET=tu_jwt_secret_aqui

# Configuración de Cloudinary (obtener en https://cloudinary.com/)
# CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
# CLOUDINARY_API_KEY=tu_api_key_aqui
# CLOUDINARY_API_SECRET=tu_api_secret_aqui 