# Configuración del Backend para PRODUCCIÓN - Onkos Instituto del Cáncer
# Este archivo se usa en Render.com

# API Key de Groq AI (configurar en Render.com Environment Variables)
GROQ_API_KEY=[REDACTED]

# Puerto del servidor backend (Render.com lo asigna automáticamente)
PORT=${PORT}

# Entorno de ejecución
NODE_ENV=production

# URL de conexión a PostgreSQL (configurar en Render.com Environment Variables)
DATABASE_URL=${DATABASE_URL}

# Configuración de CORS para producción
CORS_ORIGIN=${CORS_ORIGIN}

# JWT Secret (configurar en Render.com Environment Variables)
JWT_SECRET=${JWT_SECRET}

# Configuración adicional para producción
LOG_LEVEL=info

# Configuración de Cloudinary (configurar en Render.com Environment Variables)
CLOUDINARY_CLOUD_NAME=${CLOUDINARY_CLOUD_NAME}
CLOUDINARY_API_KEY=${CLOUDINARY_API_KEY}
CLOUDINARY_API_SECRET=${CLOUDINARY_API_SECRET} 